# MedFlow-AI Backend — Variables de entorno
# Copia este archivo como .env y rellena los valores reales

# Groq API Key — obtener en: https://console.groq.com/keys
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Entorno (development | production)
ENVIRONMENT=development

# CORS — en producción, reemplaza * con tu dominio de Vercel
# ALLOWED_ORIGINS=https://medflow-ai.vercel.app
